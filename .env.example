# Copy to .env.local for local use; on Vercel set these in Project Settings > Environment Variables.
# Never commit real values.

# Contact form (src/app/api/contact/route.ts), sent through SendGrid
SENDGRID_API_KEY=
# Where messages go; several addresses separated by commas
CONTACT_TO_EMAIL=
# Sender verified in SendGrid (Single Sender Verification or an authenticated domain)
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Mocean Beach Resort website

# Cloudflare cache purge (scripts/purge-cloudflare.ts). In GitHub: repository secrets, not this file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Booking engine on /book/ (src/lib/cloudbeds/, docs/booking-engine.md). Without the key and property ID the page
# shows demo rooms everywhere but the production site (development, Vercel previews; or anywhere with BOOKING_DEMO=1);
# on the production site it sends guests to Cloudbeds' page.
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=
# cash | credit | ebanking | pay_pal (no money is taken by the site; see the doc for deposit options)
CLOUDBEDS_PAYMENT_METHOD=cash
# Item IDs from Cloudbeds Items & Services offered as extras (transfers), comma-separated
CLOUDBEDS_ADDON_ITEM_IDS=
# Optional: CLOUDBEDS_SOURCE_ID, CLOUDBEDS_SEND_EMAIL=false, BOOKING_INCLUDED_TAX_RATE=0.221, BOOKING_DEMO=1

# The resort's OWN booking system (src/lib/booking/native/, admin at /admin/; docs/booking-native.md).
# BOOKING_PROVIDER=native makes /book/ use it instead of Cloudbeds or demo data. Leave empty to keep the current behaviour.
BOOKING_PROVIDER=
# Postgres, e.g. Neon through the Vercel Marketplace. Not needed in development: without it a local test database is made
# in node_modules/.cache/mocean-pglite on first use (login for /admin/ there: see DEV_ADMIN in src/lib/db/dev-admin.ts).
DATABASE_URL=
# Direct (not pooled) address, used only by `npm run db:setup`; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Signs the /admin/ login cookie: a random string of at least 32 characters (required in production).
ADMIN_SESSION_SECRET=
# Where new-booking notices go, comma-separated. Default: CONTACT_TO_EMAIL. Guest emails use the same SendGrid settings as the contact form.
BOOKING_TO_EMAIL=
# Signs the guests' "Manage my booking" links (/book/manage/): random, 32+ characters. Falls back to ADMIN_SESSION_SECRET.
# Changing it makes the links in emails already sent stop working (guests can still find a booking by number and email).
BOOKING_LINK_SECRET=
# Optional: the site address used in those links, e.g. https://moceanbeachresort.com (default: the Vercel deployment).
BOOKING_SITE_URL=

# Trial version, beside the current booking engine (docs/booking-native.md, "Trial version"). ONLY on a trial deployment
# with its own database, never on the live site. 1 = the admin and /book/ say it is a trial; sample bookings on /admin/guide/.
BOOKING_TRIAL=
# In the trial, every email goes only here (comma-separated), marked [Trial]. Empty: no email is sent at all.
BOOKING_TRIAL_EMAIL=

# Online payment through Xendit (src/lib/payments/xendit.ts; switch it on in /admin/payments/). Both are needed.
# Secret API key: Xendit Dashboard > Settings > API Keys. A test key makes test payments only.
XENDIT_SECRET_KEY=
# Webhook verification token: Xendit Dashboard > Settings > Webhooks. Set the invoice webhook to <site>/api/payments/xendit/
XENDIT_CALLBACK_TOKEN=
